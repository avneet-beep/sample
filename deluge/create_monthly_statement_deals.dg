	rows.add("EN99DT|4.81|833326000071964215|833326000071952738|833326000069968066|suresh@vittamantra.com|9900688332");
	rows.add("ZZXE56|1.95|833326000076283076|833326000076296006|833326000092957001|vikas@linkupnetworks.in|9138933333");
	rows.add("2V4B24|0.75|833326000071964915|833326000071953154|833326000092957001|creekconcept1@gmail.com|9880002787");
	rows.add("3KFNWS|0.3|833326000071969345|833326000071954705|833326000069968066|marketing@beyondcolor.in|6265176315");
	info "Rows in data set: " + rows.size();
	// ---------------------------------------------------------------
	// PROCESS
	// ---------------------------------------------------------------
	created_count = 0;
	skipped_low_count = 0;
	skipped_dup_count = 0;
	failed_count = 0;
	failure_log = List();
	for each  row in rows
	{
		if(created_count >= MAX_RECORDS_PER_RUN)
		{
			info "MAX_RECORDS_PER_RUN reached - stopping";
			break;
		}
		parts = row.toList("|");
		ban = parts.get(0);
		amount = parts.get(1).toDecimal();
		ban_id = parts.get(2);
		account_id = parts.get(3);
		owner_id = parts.get(4);
		email = parts.get(5);
		phone = parts.get(6);
		deal_name = ban + NAME_SUFFIX;
		// --- Skip low-value rows ---
		if(amount < MIN_AMOUNT)
		{
			info "SKIP " + deal_name + " - amount " + amount + " is below " + MIN_AMOUNT;
			skipped_low_count = skipped_low_count + 1;
			continue;
		}
		// --- Skip rows already created by an earlier run ---
		if(CHECK_DUPLICATES)
		{
			existing = zoho.crm.searchRecords("Deals","(Deal_Name:equals:" + deal_name + ")");
			if(existing.size() > 0)
			{
				info "SKIP " + deal_name + " - already exists (" + existing.get(0).getJSON("id") + ")";
				skipped_dup_count = skipped_dup_count + 1;
				continue;
			}
		}
		// --- Build the Deal ---
		layout_map = Map();
		layout_map.put("name",LAYOUT_NAME);
		layout_map.put("id",LAYOUT_ID);
		deal_map = Map();
		deal_map.put("Deal_Name",deal_name);
		deal_map.put("Amount",amount);
		deal_map.put("Stage",STAGE);
		deal_map.put("Closing_Date",CLOSING_DATE);
		deal_map.put("Created_Via",CREATED_VIA);
		deal_map.put("Type_of_Expansion",TYPE_OF_EXPANSION);
		deal_map.put("Pipeline",PIPELINE);
		deal_map.put("Product_Required",PRODUCT_REQUIRED);
		deal_map.put("Purpose_Need",PURPOSE_NEED);
		deal_map.put("Case_Study",CASE_STUDY);
		deal_map.put("Business_Account_Number_BAN",ban_id);
		deal_map.put("Account_Name",account_id);
		deal_map.put("Owner",owner_id);
		deal_map.put("Email",email);
		deal_map.put("Phone",phone);
		deal_map.put("Tag",tag_list);
		deal_map.put("Layout",layout_map);
		if(DRY_RUN)
		{
			info "DRY_RUN - would create: " + deal_name + " | amount " + amount + " | owner " + owner_id;
			created_count = created_count + 1;
			continue;
		}
		create_result = zoho.crm.createRecord("Deals",deal_map);
		if(create_result.get("id") == null)
		{
			info "CREATE FAILED " + deal_name + ": " + create_result;
			failed_count = failed_count + 1;
			failure_log.add(deal_name + " -> " + create_result);
			continue;
		}
		info "Created " + deal_name + " (" + create_result.get("id") + ")";
		created_count = created_count + 1;
	}
	// ---------------------------------------------------------------
	// SUMMARY
	// ---------------------------------------------------------------
	info "=============================================";
	info "Created            : " + created_count;
	info "Skipped low amount : " + skipped_low_count;
	info "Skipped duplicate  : " + skipped_dup_count;
	info "Failed             : " + failed_count;
	info "=============================================";
	if(failure_log.size() > 0)
	{
		info "--------------- FAILURES ---------------";
		for each  failure in failure_log
		{
			info failure;
		}
	}
	info "create_monthly_statement_deals finished";
}
