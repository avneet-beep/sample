void automation.create_monthly_statement_deals()
{
	/*
	================================================================================
	 Function : create_monthly_statement_deals
	 Purpose  : Create one consolidated UnPaid Bill Deal per BAN from the
	            reconciliation set, replacing the duplicates that were closed
	            as Closed Lost by bulk_close_deals.

	 DATA
	   357 rows are embedded below as "BAN|Amount|BAN_Id|Account_Id|Owner_Id|
	   Email|Phone". Every other field is identical across all rows and lives
	   in the CONFIGURATION block, so there is nothing to keep in sync.
	   Deal_Name is derived as "<BAN>" + NAME_SUFFIX.

	 SAFETY
	   - DRY_RUN = true logs the payload and creates nothing.
	   - MIN_AMOUNT skips low-value rows; 21 rows are under 100.
	   - Every row is checked for an existing Deal of the same name first, so
	     re-running continues where the last run stopped and never duplicates.
	   - MAX_RECORDS_PER_RUN caps one execution. Re-run until Created is 0.
	   - Counts and failures are printed to the execution log.
	================================================================================
	*/
	// ======================== CONFIGURATION ========================
	// Set to false only after reviewing a DRY_RUN log.
	DRY_RUN = true;
	// Rows below this Amount are skipped.
	MIN_AMOUNT = 100;
	// Deals created per execution. Two API calls per row, so keep it modest.
	MAX_RECORDS_PER_RUN = 100;
	// Skip a row when a Deal of the same name already exists. Leave true.
	CHECK_DUPLICATES = true;
	// ---- Fields identical on every Deal ----
	NAME_SUFFIX = " UnPaid Bill September 2026";
	STAGE = "Qualification";
	// ISO yyyy-MM-dd. If the API rejects it, use "2026-10-02".toDate() instead.
	CLOSING_DATE = "2026-10-02";
	// Plain picklist value, as requested. The bulk-correction detail stays in
	// CASE_STUDY below, so nothing is lost.
	CREATED_VIA = "Monthly Statement";
	TYPE_OF_EXPANSION = "Regular usage (Credits)";
	PIPELINE = "Expansion";
	PRODUCT_REQUIRED = "Call Plus WhatApp";
	PURPOSE_NEED = "UnPaid Bills";
	CASE_STUDY = "Corrected outstanding amount per BAN-level reconciliation against Redshift (2026-09-12) — replaces duplicate monthly UnPaid Bill deals for this BAN.";
	TAG_NAME = "unpaid Bill";
	TAG_ID = "833326000105640777";
	LAYOUT_NAME = "Expansion_Layout";
	LAYOUT_ID = "833326000077634330";
	// ======================= CONFIGURATION ENDS =======================
	info "=============================================";
	info "create_monthly_statement_deals started";
	info "DRY_RUN = " + DRY_RUN.toString();
	info "MIN_AMOUNT = " + MIN_AMOUNT;
	info "MAX_RECORDS_PER_RUN = " + MAX_RECORDS_PER_RUN;
	info "=============================================";
	// The tag is the same on every Deal, so build it once.
	tag_list = List();
	tag_map = Map();
	tag_map.put("name",TAG_NAME);
	tag_map.put("id",TAG_ID);
	tag_list.add(tag_map);
	// ---------------------------------------------------------------
	// DATA : BAN|Amount|BAN_Id|Account_Id|Owner_Id|Email|Phone
	// ---------------------------------------------------------------
	rows = List();
