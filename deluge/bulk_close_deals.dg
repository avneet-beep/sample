void standalone.bulk_close_deals()
{
	/*
	================================================================================
	 Function : bulk_close_deals
	 Type     : Standalone Function  (Setup > Developer Space > Functions)
	 Signature: the editor writes the first line itself. Keep whatever it
	            generated and paste only this body - the category prefix and
	            the name must match the function you created. A comment placed
	            ABOVE the signature makes the editor reject the code, which is
	            why this header lives inside the braces.
	 Purpose  : Close the Deals sitting in a CRM filter (Custom View). For each
	            eligible Deal it does three things:

	              1. Updates Stage            -> TARGET_STAGE
	              2. Adds the tag             -> AutoClosed   (existing tags kept)
	              3. Creates a Note on the Deal explaining the closure

	 TARGET STAGE
	 --------------------------------------------------------------------------
	 Target is "Closed Lost" (exact picklist spelling from the Deals layout).
	 The other closing options are "Closed Won" and "Closed Lost to Competition";
	 both are left alone by SKIP_STAGES below. A mass stage change is not easily
	 reversible - dry run first.
	 --------------------------------------------------------------------------

	 SAFETY
	   - MAX_RECORDS_PER_RUN counts ELIGIBLE Deals, not fetched rows. Set to 2 so
	     the first live run touches at most two Deals.
	   - DRY_RUN = true logs what it WOULD do and changes nothing.
	   - Deals already on a closed stage are skipped.
	   - Deals already carrying the tag are skipped, so re-runs are safe.
	   - Counts and any failures are printed to the execution log.
	================================================================================
	*/
	// ======================== CONFIGURATION ========================
	// Set to false only after you have reviewed a DRY_RUN execution log.
	DRY_RUN = true;
	// PILOT LIMIT. At most this many Deals are changed in one execution.
	// Start at 2, verify those two records in CRM, then raise it.
	MAX_RECORDS_PER_RUN = 2;
	// Stage to set. Must match the picklist spelling exactly.
	TARGET_STAGE = "Closed Lost";
	// Deals already sitting on one of these stages are left untouched.
	// Remove "Closed Won" from this list ONLY if you genuinely want won deals
	// flipped to lost - that rewrites closed revenue and forecast history.
	SKIP_STAGES = List();
	SKIP_STAGES.add("Closed Won");
	SKIP_STAGES.add("Closed Lost");
	SKIP_STAGES.add("Closed Lost to Competition");
	// Any extra field the layout makes mandatory on closure goes here, e.g.
	// EXTRA_FIELDS.put("Reason_for_Loss","System clean up");
	EXTRA_FIELDS = Map();
	// Tag to apply. Already created on the Deals module, ID below.
	TAG_NAME = "AutoClosed";
	TAG_ID = "833326000141307002";
	// Note that gets attached to every Deal.
	NOTE_TITLE = "Auto Closure - System Clean Up";
	NOTE_CONTENT = "Marked as Closed Lost automatically. This deal may have been moved to an expansion by our advisor, or settled through a waiver or another adjustment. It is being closed here to keep the system clean.";
	// ---- How the Deals are picked ----
	// Option A (recommended): use an existing CRM filter / Custom View.
	//   Open the view in CRM, the cvid is the long number in the URL.
	// Option B: use a search criteria string instead.
	USE_CUSTOM_VIEW = true;
	CUSTOM_VIEW_ID = "833326000092565978";
	SEARCH_CRITERIA = "(Stage:equals:Qualification) and (Closing_Date:less_than:2025-01-01)";
	// ---- Paging ----
	PER_PAGE = 200;
	MAX_PAGES = 10;
	// ======================= CONFIGURATION ENDS =======================
	info "=============================================";
	info "bulk_close_deals started";
	info "DRY_RUN = " + DRY_RUN.toString();
	info "TARGET_STAGE = " + TARGET_STAGE;
	info "MAX_RECORDS_PER_RUN = " + MAX_RECORDS_PER_RUN;
	info "=============================================";
	skipped_count = 0;
	// ---------------------------------------------------------------
	// STEP 1 : Collect ELIGIBLE Deals, stop as soon as the cap is hit
	// ---------------------------------------------------------------
	eligible_deals = List();
	scanned_count = 0;
	// Deluge has no numeric for-loop, so the page numbers come from a real
	// list. Add more entries if you ever need to read past page 10.
	page_list = List();
	page_list.add(1);
	page_list.add(2);
	page_list.add(3);
	page_list.add(4);
	page_list.add(5);
	page_list.add(6);
	page_list.add(7);
	page_list.add(8);
	page_list.add(9);
	page_list.add(10);
	for each  page_num in page_list
	{
		if(page_num > MAX_PAGES)
		{
			break;
		}
		page_records = List();
		if(USE_CUSTOM_VIEW)
		{
			fetch_params = Map();
			fetch_params.put("cvid",CUSTOM_VIEW_ID);
			page_records = zoho.crm.getRecords("Deals",page_num,PER_PAGE,fetch_params);
		}
		else
		{
			page_records = zoho.crm.searchRecords("Deals",SEARCH_CRITERIA,page_num,PER_PAGE);
		}
		info "Page " + page_num + " fetched " + page_records.size() + " record(s)";
		if(page_records.size() == 0)
		{
			break;
		}
		for each  deal in page_records
		{
			if(eligible_deals.size() >= MAX_RECORDS_PER_RUN)
			{
				break;
			}
			scanned_count = scanned_count + 1;
			deal_name = ifnull(deal.getJSON("Deal_Name"),"");
			current_stage = ifnull(deal.getJSON("Stage"),"");
			// Skip anything already sitting on a closed stage.
			if(SKIP_STAGES.contains(current_stage))
			{
				info "SKIP " + deal_name + " - stage is " + current_stage;
				skipped_count = skipped_count + 1;
				continue;
			}
			// Skip anything a previous run already tagged.
			already_tagged = false;
			existing_tags = deal.getJSON("Tag");
			if(existing_tags != null && existing_tags != "")
			{
				for each  existing_tag in existing_tags
				{
					if(existing_tag.getJSON("name") == TAG_NAME)
					{
						already_tagged = true;
					}
				}
			}
			if(already_tagged)
			{
				info "SKIP " + deal_name + " - already tagged " + TAG_NAME;
				skipped_count = skipped_count + 1;
				continue;
			}
			eligible_deals.add(deal);
		}
		if(eligible_deals.size() >= MAX_RECORDS_PER_RUN)
		{
			info "MAX_RECORDS_PER_RUN reached - stopping fetch";
			break;
		}
		if(page_records.size() < PER_PAGE)
		{
			break;
		}
	}
	info "Scanned " + scanned_count + " | skipped " + skipped_count + " | eligible " + eligible_deals.size();
	if(eligible_deals.size() == 0)
	{
		info "Nothing to process - exiting";
		return;
	}
	// ---------------------------------------------------------------
	// STEP 2 : Process the eligible Deals
	// ---------------------------------------------------------------
	updated_count = 0;
	failed_count = 0;
	note_failed_count = 0;
	failure_log = List();
	for each  deal in eligible_deals
	{
		deal_id = deal.getJSON("id");
		deal_name = ifnull(deal.getJSON("Deal_Name"),"");
		current_stage = ifnull(deal.getJSON("Stage"),"");
		info "----------------------------------------";
		info "Deal: " + deal_name + " (" + deal_id + ") | Stage: " + current_stage;
		// Carry the existing tags forward, otherwise they get wiped.
		tag_list = List();
		existing_tags = deal.getJSON("Tag");
		if(existing_tags != null && existing_tags != "")
		{
			for each  existing_tag in existing_tags
			{
				keep_tag = Map();
				keep_tag.put("name",existing_tag.getJSON("name"));
				keep_tag.put("id",existing_tag.getJSON("id"));
				tag_list.add(keep_tag);
			}
		}
		new_tag = Map();
		new_tag.put("name",TAG_NAME);
		if(TAG_ID != null && TAG_ID != "")
		{
			new_tag.put("id",TAG_ID);
		}
		tag_list.add(new_tag);
		// --- Build the update ---
		update_map = Map();
		update_map.put("Stage",TARGET_STAGE);
		update_map.put("Tag",tag_list);
		for each  extra_key in EXTRA_FIELDS.keys()
		{
			update_map.put(extra_key,EXTRA_FIELDS.get(extra_key));
		}
		if(DRY_RUN)
		{
			info "DRY_RUN - would update with: " + update_map;
			info "DRY_RUN - would add note: " + NOTE_TITLE;
			updated_count = updated_count + 1;
			continue;
		}
		// --- Update the Deal ---
		update_result = zoho.crm.updateRecord("Deals",deal_id,update_map);
		if(update_result.get("id") == null)
		{
			info "UPDATE FAILED: " + update_result;
			failed_count = failed_count + 1;
			failure_log.add(deal_name + " (" + deal_id + ") -> " + update_result);
			continue;
		}
		info "Stage + tag updated";
		updated_count = updated_count + 1;
		// --- Attach the Note ---
		note_map = Map();
		note_map.put("Note_Title",NOTE_TITLE);
		note_map.put("Note_Content",NOTE_CONTENT);
		note_map.put("Parent_Id",deal_id);
		note_map.put("se_module","Deals");
		note_result = zoho.crm.createRecord("Notes",note_map);
		if(note_result.get("id") == null)
		{
			info "NOTE FAILED: " + note_result;
			note_failed_count = note_failed_count + 1;
			failure_log.add("NOTE " + deal_name + " (" + deal_id + ") -> " + note_result);
		}
		else
		{
			info "Note attached";
		}
	}
	// ---------------------------------------------------------------
	// STEP 3 : Summary
	// ---------------------------------------------------------------
	info "=============================================";
	info "Eligible      : " + eligible_deals.size();
	info "Updated       : " + updated_count;
	info "Skipped       : " + skipped_count;
	info "Update failed : " + failed_count;
	info "Note failed   : " + note_failed_count;
	info "=============================================";
	if(failure_log.size() > 0)
	{
		info "--------------- FAILURES ---------------";
		for each  failure in failure_log
		{
			info failure;
		}
	}
	info "bulk_close_deals finished";
}
